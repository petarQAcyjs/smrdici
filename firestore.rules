rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Функција за проверу да ли је корисник аутентификован
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Функција за проверу да ли је корисник власник
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Правила за кориснике и њихове догађаје
    match /users/{userId}/{document=**} {
      allow read, write: if isAuthenticated();
    }
    
    // Правила за календарске догађаје
    match /calendar_events/{eventId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && 
                   request.resource.data.createdBy == request.auth.uid;
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }
    
    // Правила за листе за куповину
    match /shopping_lists/{listId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.createdBy == request.auth.uid;
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }
    
    // Правила за migration_flags колекцију
    match /migration_flags/{userId} {
      allow read, write: if isOwner(userId);
    }
    
    // Основна правила - забрањујемо све остало
    match /{document=**} {
      allow read, write: if false;
    }
  }
} 